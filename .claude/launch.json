{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "cropshift-api",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "run.py",
        "api"
      ],
      "port": 8000
    },
    {
      "name": "cropshift-api-8011",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "api.main:app",
        "--port",
        "8011"
      ],
      "env": {
        "MOCK": "0"
      },
      "port": 8011
    },
    {
      "name": "cropshift-mock",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "api.main:app",
        "--port",
        "8021"
      ],
      "env": {
        "MOCK": "1"
      },
      "port": 8021
    },
    {
      "name": "hf-space-staged",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "--app-dir",
        "dist/hf_space",
        "api.main:app",
        "--port",
        "7860"
      ],
      "env": {
        "MOCK": "0"
      },
      "port": 7860
    }
  ]
}