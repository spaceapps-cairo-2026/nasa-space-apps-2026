__pycache__/
*.pyc
.venv/
.env
.pytest_cache/
data/raw/
# Small datasets ARE committed (NASA POWER cache + processed tables). Big or login-only data is not.
data/cache/*
!data/cache/power/
!data/cache/gistemp/
!data/cache/ecocrop/
ml/artifacts/
*.nc
*.h5
*.tif
.DS_Store
.pip-cache/
ml/outputs/world_*.json
# Except the Whole Earth layer the app loads (air temperature, default years): Render free wipes its disk on every wake-up
!ml/outputs/world_T2M_s2.json
dist/
# Raw hand-over from Manus (41 MB zip, over the 20 MB rule). What the app needs is copied to ml/crop_model/.
manus-model/

