{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "farming.schema.json",
  "title": "FarmingOutlook (F2 farmland, F3 crops, F4 decisions)",
  "description": "Lane B addition for lane A to review. Served by GET /api/farming?country=EGY, built by python ml/farming.py. Flat arrays use index k = i * ncols + j, row i from the south, column j from the west.",
  "type": "object",
  "required": [
    "version",
    "region",
    "grid",
    "method",
    "horizons",
    "inside",
    "crops",
    "suitability",
    "evidence",
    "suitable_threshold"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "region": {
      "type": "object",
      "required": [
        "id",
        "name",
        "bbox"
      ]
    },
    "grid": {
      "type": "object",
      "required": [
        "lat0",
        "lon0",
        "dlat",
        "dlon",
        "nrows",
        "ncols"
      ],
      "properties": {
        "lat0": {
          "type": "number"
        },
        "lon0": {
          "type": "number"
        },
        "dlat": {
          "type": "number"
        },
        "dlon": {
          "type": "number"
        },
        "nrows": {
          "type": "integer"
        },
        "ncols": {
          "type": "integer"
        }
      }
    },
    "method": {
      "type": "string"
    },
    "horizons": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "minItems": 1
    },
    "inside": {
      "type": "string",
      "pattern": "^[01]*$"
    },
    "evidence": {
      "type": "string",
      "pattern": "^[SMN-]*$"
    },
    "suitable_threshold": {
      "type": "number"
    },
    "crops": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "season_months"
        ]
      }
    },
    "suitability": {
      "type": "object",
      "properties": {
        "irrigated": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 100
              }
            }
          }
        },
        "rainfed": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 100
              }
            }
          }
        }
      },
      "required": [
        "irrigated"
      ]
    },
    "suitability_10_low": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "array",
          "items": {
            "type": [
              "integer",
              "number",
              "null"
            ]
          }
        }
      }
    },
    "suitability_10_high": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "array",
          "items": {
            "type": [
              "integer",
              "number",
              "null"
            ]
          }
        }
      }
    },
    "best_start_month": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "array",
          "items": {
            "type": [
              "integer",
              "number",
              "null"
            ]
          }
        }
      }
    },
    "years_to_heat_limit": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": [
            "integer",
            "number",
            "null"
          ]
        }
      }
    }
  }
}
